{
	"schemaVersion": "0.1.0",
	"name": "Daz 3D product",
	"behavior": "create",
	"noteContentFormat": "# {{meta:property:og:title}}\n\n## Description\n\n{{selectorHtml:.description .std|remove_tags:\"a\"|markdown}}",
	"properties": [
		{
			"name": "url",
			"value": "{{url|split:\\\"#\\\"|first}}",
			"type": "text"
		},
		{
			"name": "originalPrice",
			"value": "{{schema:@Product:offers.price}} {{schema:@Product:offers.priceCurrency}}",
			"type": "text"
		},
		{
			"name": "artists",
			"value": "{{selector:.display_medium_up .compatible.first .data a|join}}",
			"type": "multitext"
		},
		{
			"name": "requiredProducts",
			"value": "{% set required = selector:.display_medium_up .compatible.required li a %}{% for item in required %}{% if item contains \\\"starter essentials\\\" %}{% else %}{{item|wikilink}}{% endif %}{% if !loop.last %},{% endif %}{% endfor %}",
			"type": "multitext"
		},
		{
			"name": "compatibleFigures",
			"value": "{{selectorHtml:.display_medium_up .compatinfo .compatible.first ~ .compatible > .data|remove_html:(\\\"a\\\")|strip_tags|join:\\\",\\\"|trim}}",
			"type": "multitext"
		},
		{
			"name": "productID",
			"value": "{{selector:.display_medium_up .sku_number}}",
			"type": "text"
		},
		{
			"name": "dateCreated",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm:ssZ\\\"}}",
			"type": "datetime"
		},
		{
			"name": "tags",
			"value": "ds-asset",
			"type": "multitext"
		}
	],
	"triggers": [
		"/^https:\\/\\/www\\.daz3d\\.com\\/.+(?!\\/bundle\\/)$/"
	],
	"noteNameFormat": "{{meta:property:og:title|safe_name}}",
	"path": "4 Ressurser/Daz Studio Assets/Daz 3D/daz 3d products"
}